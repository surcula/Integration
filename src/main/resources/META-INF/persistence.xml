<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">
    <persistence-unit name="default" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>be.atc.erpprojetintegration_1.entities.Employee</class>
        <class>be.atc.erpprojetintegration_1.entities.Address</class>
        <class>be.atc.erpprojetintegration_1.entities.City</class>
        <class>be.atc.erpprojetintegration_1.entities.Role</class>
        <class>be.atc.erpprojetintegration_1.entities.Authorization</class>
        <class>be.atc.erpprojetintegration_1.entities.RolesAuthorization</class>
        <class>be.atc.erpprojetintegration_1.entities.Department</class>
        <class>be.atc.erpprojetintegration_1.entities.DepartmentHead</class>
        <class>be.atc.erpprojetintegration_1.entities.EmployeeDepartment</class>
        <class>be.atc.erpprojetintegration_1.entities.Company</class>
        <class>be.atc.erpprojetintegration_1.entities.Function</class>
        <class>be.atc.erpprojetintegration_1.entities.Planning</class>
        <class>be.atc.erpprojetintegration_1.entities.PlanningsEmployee</class>
        <class>be.atc.erpprojetintegration_1.entities.PlanningEmployeeSwapRequest</class>
        <class>be.atc.erpprojetintegration_1.entities.PlanningSwapProposal</class>
        <class>be.atc.erpprojetintegration_1.entities.PublicHoliday</class>
        <class>be.atc.erpprojetintegration_1.entities.Absence</class>
        <class>be.atc.erpprojetintegration_1.entities.Contract</class>

        <properties>
            <property name="javax.persistence.jdbc.driver" value="com.mysql.jdbc.Driver"/>
            <property name="javax.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/erp_projet_integration?useSSL=false&amp;useUnicode=true&amp;characterEncoding=UTF-8"/>
            <property name="javax.persistence.jdbc.user" value="root"/>
            <property name="javax.persistence.jdbc.password" value=""/>

            <property name="eclipselink.logging.level" value="FINE"/>
            <property name="eclipselink.ddl-generation" value="none"/>
            <property name="eclipselink.cache.shared.default" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
